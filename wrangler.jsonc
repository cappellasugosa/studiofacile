{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studiofacile",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "GEMINI_MODELS": "gemini-3.6-flash,gemini-2.5-flash-lite,gemini-2.5-flash",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "OPENROUTER_MODEL": "openrouter/free",
    "SITE_URL": "https://studiofacile.studylab.workers.dev"
  }
}
